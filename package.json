    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.5.0",
    "prettier": "^3.3.0",
    "eslint": "^9.10.0"
  },
  "packageManager": "pnpm@9.10.0"
}
