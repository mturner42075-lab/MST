{
  "name": "comic-catalog",
  "private": true,
  "scripts": {
    "dev:web": "turbo run dev --filter=@comic-catalog/web",
    "dev:mobile": "turbo run dev --filter=@comic-catalog/mobile",
    "dev:desktop": "turbo run dev --filter=@comic-catalog/desktop",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@comic-catalog/web",
    "lint": "turbo run lint",
